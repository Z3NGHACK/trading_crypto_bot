# Copy this file to .env and fill in your values

# Binance Testnet API Keys (get from https://testnet.binance.vision/)
EXCHANGE_API_KEY=your_testnet_api_key_here
EXCHANGE_API_SECRET=your_testnet_secret_here

# Binance Mainnet API Keys (for real trading - use with caution)
# EXCHANGE_API_KEY=your_mainnet_api_key_here
# EXCHANGE_API_SECRET=your_mainnet_secret_here

# Trading Mode
SANDBOX_MODE=true

# Risk Management
INITIAL_CAPITAL=1000
MAX_RISK_PER_TRADE=0.02

# Logging
LOG_LEVEL=INFO